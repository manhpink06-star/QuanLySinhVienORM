@model QuanLySinhVienORM.Models.SinhVien

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<div class="container mt-4">

    <h2>XÓA SINH VIÊN</h2>

    <div class="alert alert-danger">
        Bạn có chắc chắn muốn xóa sinh viên này không?
    </div>


    @if (!string.IsNullOrEmpty(Model.HinhAnh))
    {
        <div class="mb-3">

            <img src="~/images/students/@Model.HinhAnh"
                 width="150"
                 height="150"
                 style="object-fit:cover;"
                 class="rounded border"
                 alt="@Model.HoTen" />

        </div>
    }


    <table class="table table-bordered">

        <tr>
            <th>Mã sinh viên</th>
            <td>@Model.MaSV</td>
        </tr>

        <tr>
            <th>Họ tên</th>
            <td>@Model.HoTen</td>
        </tr>

        <tr>
            <th>Lớp</th>
            <td>@Model.Lop</td>
        </tr>

        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>

    </table>


    <form asp-action="Delete"
          asp-route-id="@Model.MaSV"
          method="post">

        <button type="submit"
                class="btn btn-danger">
            Xác nhận xóa
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Hủy
        </a>

    </form>

</div>