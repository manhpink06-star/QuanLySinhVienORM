@model QuanLySinhVienORM.Models.SinhVien

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<div class="container mt-4">

    <h2>CHI TIẾT SINH VIÊN</h2>

    <hr />


    <div class="mb-3">

        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="~/images/students/@Model.HinhAnh"
                 width="180"
                 height="180"
                 style="object-fit:cover;"
                 class="rounded border"
                 alt="@Model.HoTen" />
        }
        else
        {
            <p>Chưa có ảnh</p>
        }

    </div>


    <table class="table table-bordered">

        <tr>
            <th>Mã sinh viên</th>
            <td>@Model.MaSV</td>
        </tr>

        <tr>
            <th>Họ tên</th>
            <td>@Model.HoTen</td>
        </tr>

        <tr>
            <th>Ngày sinh</th>
            <td>
                @Model.NgaySinh.ToString("dd/MM/yyyy")
            </td>
        </tr>

        <tr>
            <th>Giới tính</th>
            <td>@Model.GioiTinh</td>
        </tr>

        <tr>
            <th>Lớp</th>
            <td>@Model.Lop</td>
        </tr>

        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>

        <tr>
            <th>Điểm trung bình</th>
            <td>@Model.DiemTrungBinh</td>
        </tr>

    </table>


    <a asp-action="Edit"
       asp-route-id="@Model.MaSV"
       class="btn btn-warning">
        Sửa
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>

</div>